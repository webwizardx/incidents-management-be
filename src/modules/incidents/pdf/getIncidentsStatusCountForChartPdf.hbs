<html>
  <head>
    <title>Reportes de incidencias por estatus</title>
    <script src='https://cdn.tailwindcss.com'></script>
  </head>
  <body>
    <div class='h-[297mm] w-[210mm] p-12'>
      <div class='flex justify-between'>
        <div>
          <p class='pb-2 text-4xl'>Mercantil Seguros C.A.</p>
        </div>
        <div>
          <img
            class='w-40'
            src='https://www.mercantilseguros.com/static/img/mercantil-em.png'
          />
        </div>
      </div>
      <div class='flex justify-between pt-16'>
        <div>
          <p>{{date}}</p>
          <p class='pb-3 text-xl font-bold'>Reportes de incidencias por estatus</p>
          <p class='text-sm font-bold'>Número de reporte #.
            <span class='pl-1 font-normal'>{{reportNumber}}</span></p>
        </div>
      </div>
      <div class='pt-16'>
        <table class='w-full table-auto text-sm divide-y divide-gray-300'>
          <thead class='border-b-2'>
            <tr class='divide-x divide-gray-200 h-10 text-left'>
              <th class='w-1/3 px-2'>Estatus</th>
              <th class='w-1/3 px-2'>Cantidad de incidencias</th>
            </tr>
          </thead>
          <tbody class='divide-y divide-gray-200 bg-white'>
            {{#each data}}
              <tr class='divide-x divide-gray-200 h-10'>
                <td class='w-1/3 px-2'>{{status}}</td>
                <td class='w-1/3 px-2'>{{incidentsCount}}</td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      <div class='flex justify-end'>
        <p class='pt-6 text-xl font-bold'>Total de incidencias: {{total}}</p>
      </div>
    </div>
  </body>
</html>
